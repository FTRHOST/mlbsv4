local ActivityNew_View_SF_Shop =require("mlf/ruledact/Act_IKIDraw/ActivityNew_View_SF_Shop")
local TabType = {
    Exchange = 1,
    Give = 2,
}
function ActivityNew_View_SF_Shop:RefreshReward()
    --大奖
    local bigReward = self.mActivityData:GetClient_mDisplayParamByKey("BigReward")
    local picInfo = self.mActivityData:GetClient_mDisplayParamByKey("BigRewardPic")
    local picExchangeInfo = self.mActivityData:GetClient_mDisplayParamByKey("BigExchangeRewardPic")
    local bigRewardList = string.split(bigReward, ";")
    local picInfoList = string.split(picInfo, ";")
    local picExInfoList = string.split(picExchangeInfo, ";")
    self.bigRewardDataList = {}
    for i = 1, #bigRewardList do
        local isShow = true
        local bigRewardId = tonumber(bigRewardList[i])
        local exchangeShop = self.mActivityData:GetExchangeShopByAwardId(bigRewardId)
        if(self.curTabType == TabType.Give) then
            if(exchangeShop and exchangeShop.iGiveMaxNum <= 0) then
                isShow = false
            end
        end
        -- 筛选类型过滤（mCurFilterIndex > 1 时生效）
        if isShow then
            isShow = self:IsRewardIdInAnyKnownType(exchangeShop.index)
        end
        if(isShow)then
            table.insert(self.bigRewardDataList, {id = bigRewardId, index = exchangeShop.index, pic = picInfoList[i], exPic = picExInfoList[i]})
        end
    end
    table.sort(self.bigRewardDataList, function(a, b)
        if a == nil or b == nil then
            return false
        end

        local aOwner = self.mActivityData:IsOwnerItemByShopId(a.index)
        local bOwner = self.mActivityData:IsOwnerItemByShopId(b.index)
        if aOwner ~= bOwner then
            return bOwner
        end
        local aSellOut = self.mActivityData:IsSellOutByShopId(a.index)
        local bSellOut = self.mActivityData:IsSellOutByShopId(b.index)
        if aSellOut ~= bSellOut then
            return bSellOut
        end
        return a.index < b.index
    end)
    self.bigAwardListGrid:FillList(#self.bigRewardDataList)
    LuaUtils.SetLocalPosition(self.m_Grid_Exchange, -460.1, 50 - 282.2 * math.floor(#self.bigRewardDataList / 2), 0)
    --普通奖励
    self.rewardDataList = {}
    local allExchangeShop = self.mActivityData:GetAllExchangeShop()
    for i = 1, #allExchangeShop do
        local isShow = true
        local exchangeShop = allExchangeShop[i]
        if(self.curTabType == TabType.Give) then
            if(exchangeShop and exchangeShop.iGiveMaxNum <= 0) then
                isShow = false
            end
        end
        -- 筛选类型过滤（mCurFilterIndex > 1 时生效）
        if isShow then
            isShow = self:IsRewardIdInAnyKnownType(exchangeShop.index)
        end
        if(isShow)then
            
            table.insert(self.rewardDataList, exchangeShop)
        end
    end

    self.awardListGrid:FillList(#self.rewardDataList)
end
[2026-08-18 02:11:17.997 38] LateLuaUpdate : Fix_IKIDrawActivity
require("ui/huodong/IKIDrawActivity")
function IKIDrawActivity:IsOwnerItemByShopId(shopId)
    local exchangeShop = self:GetExchangeShopByShopId(shopId)
    if exchangeShop == nil or exchangeShop.vReward == nil then
        return false
    end
    local reward = exchangeShop.vReward[1]
    if reward == nil then
        return false
    end

    local isOwner = LuaUtils.IsHaveOwner(reward.iID)
    if isOwner then
        return true
    end
    return false
end
