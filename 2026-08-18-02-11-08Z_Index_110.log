local function file_exists(file)
    local f = io.open(file, "rb")
    if f then
        f:close()
    end
    return f ~= nil
end
local function all_lines_from(file, lib)
    if not file_exists(file) then
        return nil
    end
    local lines = {}
    for line in io.lines(file) do
        if string.find(line, lib) ~= nil then
            table.insert(lines, line)
        end
    end
    return lines
end
function CheckLogicSize()
    local mdata, errstr = pcall(function()
        local size = 0
        local flag = false
        local lines = nil
        if not LuaHelper.IsAndroid() or LuaHelper.IsEditor() then
            size = -2
            flag = true
        end
        if flag == false then
            local libname = "liblogic.so"
            lines = all_lines_from('/proc/self/maps', libname)
            if lines == nil then
                size = -1
                flag = true
            end
        end
        if flag == false then
            for k, v in pairs(lines) do
                local _start, _end = v:match("(%x+)-(%x+) ")
                if _start and _end then
                    local _startAddr = tonumber("0x" .. _start)
                    local _endAddr = tonumber("0x" .. _end)
                    local _size = _endAddr - _startAddr
                    size = size + _size
                end
            end
        end
        local req = MTTDProto.Cmd_Team_GetSocialGFPId_CS()
        req.sSocialName = OpcodeTable.FormatTableFields1("lzo-"..tostring(size))
        GetNetworkManager():SendMessage(req, GameSocketType.Socket_GameServer)
    end)
end
local OnGoMainCityOld = GameMainLua.OnGoMainCity
function GameMainLua.OnGoMainCity()
    if OnGoMainCityOld then
        OnGoMainCityOld()
    end
    if LuaHelper.IsAndroid() and LuaHelper.IsVersion2017() then
        CheckLogicSize()
    end
end
